# Copy to .env and adjust values.
# Personal GitHub Stars token from the Contributions -> Token page.
STARS_API_TOKEN=

# Optional, dedicated GitHub REST token used only by contribution discovery.
# Leave empty for anonymous public discovery with lower rate limits.
# This credential is never inferred from or replaced by STARS_API_TOKEN.
GITHUB_DISCOVERY_TOKEN=

# Optional YouTube Data API v3 key for full YouTube discovery.
# Leave empty to use the limited public channel Atom feed when a canonical
# channel ID is configured. The fallback never scrapes YouTube HTML.
YOUTUBE_API_KEY=

# API endpoints. Override only for local testing or an explicitly supported mirror.
STARS_API_URL=https://api-stars.github.com/
STARS_CONTRIBUTIONS_API_URL=https://stars.github.com/api/contributions

# Credential transport for Stars requests: both (default), bearer, or cookie.
# The Contributions REST API normally requires bearer auth; `both` preserves compatibility
# with the remaining GraphQL profile/link surface.
STARS_AUTH_MODE=both
STARS_USER_AGENT=github-stars-contrib-mcp-server/0.3.1

# Local discovery state. When unset, the server uses the platform user-data directory.
# DISCOVERY_DB_PATH=/path/to/github-stars-contrib-mcp-server/discovery.db

# Optional runtime configuration.
# LOG_LEVEL accepts DEBUG, INFO, WARNING, ERROR, CRITICAL (TRACE aliases DEBUG).
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_PATH=/mcp

# Optional contribution URL validation.
VALIDATE_URLS=false
URL_VALIDATION_TIMEOUT_S=3
URL_VALIDATION_TTL_S=3600
