# Copy to .env and adjust values.
# Personal GitHub Stars token from the Contributions -> Token page.
STARS_API_TOKEN=

# API endpoints. Override only for local testing or an explicitly supported mirror.
STARS_API_URL=https://api-stars.github.com/
STARS_CONTRIBUTIONS_API_URL=https://stars.github.com/api/contributions

# Optional runtime configuration.
# LOG_LEVEL accepts DEBUG, INFO, WARNING, ERROR, CRITICAL (TRACE aliases DEBUG).
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_PATH=/mcp

# Optional contribution URL validation.
VALIDATE_URLS=false
URL_VALIDATION_TIMEOUT_S=3
URL_VALIDATION_TTL_S=3600
